NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DATA_DIR=/var/lib/agentscore-storage/data
# Host directory mounted by Compose; start-server.sh prepares it on first launch.
QUALITY_STORAGE_DIR=/var/lib/agentscore-storage
QUALITY_UID=1000
QUALITY_GID=1000
# Generate with: openssl rand -hex 32
JWT_SECRET=
ALLOWED_EMAIL_DOMAIN=pashapay.az
ALLOW_PUBLIC_REGISTRATION=false
SEED_DEMO=false
# Existing internal browser URL. HTTP traffic is not encrypted.
QUALITY_PUBLIC_ORIGIN=http://192.168.68.41:8787
QUALITY_INTERNAL_HTTP=true
QUALITY_BIND_HOST=192.168.68.41
QUALITY_TRUST_PROXY=0
CHAT_SOURCE_ENABLED=false
# MySQL-only chat/call QA: MongoDB settings are not required in this mode.
CHAT_SOURCE_BACKEND=mysql
# Set CHAT_SOURCE_BACKEND=http to read chats through the Calls API without Mongo/MySQL.
# Calls still use their existing MySQL catalog. Keep its credentials below.
CALL_SOURCE_BACKEND=mysql
CALLS_BASE_URL=https://calls.pashapay.az
# Existing server-only Calls credentials also authorize the HTTP chat source.
CALLS_USER=
CALLS_PASS=
CHAT_SOURCE_QUERY_TIMEOUT_MS=60000
CHAT_SOURCE_CORPORATE_PROFILE=true
CHAT_SOURCE_MYSQL_HOST=192.168.46.4
CHAT_SOURCE_MYSQL_PORT=3306
CHAT_SOURCE_MYSQL_USER=readonly_user
CHAT_SOURCE_MYSQL_PASSWORD=
CHAT_SOURCE_MYSQL_DATABASE=report
# Existing internal MySQL connection; Docker enables this pinned corporate profile.
CHAT_SOURCE_MYSQL_TLS=false
# Chats through the Calls HTTP API (catalog from search only; messages are read just for
# chats selected for review). Optional tuning after running chatQa/httpProbeCli.js:
# CHAT_SOURCE_BACKEND=http
# Page size: 50, 100, 200 or 500 (only a size the probe reports as accepted).
# CHAT_HTTP_PAGE_SIZE=500
# Parallel requests to calls.pashapay.az: 1-8.
# CHAT_HTTP_CONCURRENCY=4
# Generate with: openssl rand -base64 32
CHAT_SAMPLING_HMAC_SECRET=
# Recording files are an on-demand cache; evaluations and catalog records remain.
CALLS_RECORDING_CACHE_IDLE_SECONDS=3600
CALLS_RECORDING_CACHE_MAX_BYTES=536870912
# Optional only when deliberately enabling MySQL TLS with a corporate CA:
# NODE_EXTRA_CA_CERTS=/var/lib/agentscore-storage/certs/mysql-ca.pem
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
AUDIO_SERVICE_URL=http://127.0.0.1:8788
LOG_LEVEL=info
# Jira employee complaints: keep disabled until a server-only PAT is configured.
# Polling runs hourly and at startup; Jira conclusions and closure remain manual.
# On the deployment host: sudo python3 scripts/configure-complaints.py
COMPLAINTS_ENABLED=false
JIRA_BASE_URL=https://jira.pashapay.az
JIRA_TOKEN=
# Required only for a new empty database; omit when restoring existing users.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
