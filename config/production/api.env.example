NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/agentscore-storage/data
# Generate with: openssl rand -hex 32
JWT_SECRET=
ALLOWED_EMAIL_DOMAIN=pashapay.az
ALLOW_PUBLIC_REGISTRATION=false
SEED_DEMO=false
CORS_ORIGINS=https://quality.internal.example
TRUST_PROXY=1
CHAT_SOURCE_ENABLED=false
# MySQL-only chat/call QA: MongoDB settings are not required in this mode.
CHAT_SOURCE_BACKEND=mysql
CHAT_SOURCE_MYSQL_HOST=db.internal
CHAT_SOURCE_MYSQL_PORT=3306
CHAT_SOURCE_MYSQL_USER=readonly_user
CHAT_SOURCE_MYSQL_PASSWORD=
CHAT_SOURCE_MYSQL_DATABASE=report
CHAT_SOURCE_MYSQL_TLS=true
# Generate with: openssl rand -base64 32
CHAT_SAMPLING_HMAC_SECRET=
# Trust your DBA-provided CA inside the existing storage mount:
# NODE_EXTRA_CA_CERTS=/var/lib/agentscore-storage/certs/mysql-ca.pem
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
AUDIO_SERVICE_URL=http://127.0.0.1:8788
LOG_LEVEL=info
# Required only for a new empty database; omit when restoring existing users.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
